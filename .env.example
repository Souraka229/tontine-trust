# === Supabase (auth + profiles) ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Même URL pour le bot Flask (sync groupes WhatsApp → app web)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Kkiapay (fiat on-ramp MoMo) ===
VITE_KKIAPAY_BASE_URL=https://api.kkiapay.me
VITE_KKIAPAY_PUBLIC_KEY=your-public-key
VITE_KKIAPAY_PRIVATE_KEY=your-private-key
VITE_KKIAPAY_SECRET=your-secret
VITE_KKIAPAY_SANDBOX=true

# === FlashBot API (WhatsApp bot backend) ===
VITE_FLASHBOT_API_URL=http://localhost:5000

# === Bitcoin Treasury (optional mainnet address) ===
VITE_BTC_TREASURY_ADDRESS=
VITE_LNBITS_ENABLED=true
VITE_LNBITS_URL=https://demo.lnbits.com

# === Demo mode ===
VITE_DEMO_PAYMENTS=true
