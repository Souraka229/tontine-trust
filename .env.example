# Supabase — projet cloud : https://slyizcavccnkvxqtmfmd.supabase.co
VITE_SUPABASE_URL=https://slyizcavccnkvxqtmfmd.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Kkiapay (sandbox)
VITE_KKIAPAY_BASE_URL=https://api.kkiapay.me
VITE_KKIAPAY_PUBLIC_KEY=
VITE_KKIAPAY_PRIVATE_KEY=
VITE_KKIAPAY_SECRET=
VITE_KKIAPAY_SANDBOX=true

# Adresse trésor Bitcoin mainnet que VOUS contrôlez (bc1q…)
# À renseigner quand vous avez l'adresse — voir scripts/setup-btc-treasury.ps1
VITE_BTC_TREASURY_ADDRESS=
VITE_BTC_NETWORK=mainnet

# LNbits Lightning (trésor instantané — secrets edge uniquement)
VITE_LNBITS_ENABLED=true
# URL publique affichée (optionnel)
# VITE_LNBITS_URL=https://legend.lnbits.com
# LNBITS_URL=https://legend.lnbits.com
# LNBITS_TREASURY_INVOICE_KEY=
# LNBITS_TREASURY_ADMIN_KEY=
# LNBITS_WEBHOOK_SECRET=  (optionnel — extension Webhook LNbits → lnbits-webhook)

# Edge function btc-treasury-sync (secrets Supabase Dashboard → Edge Functions)
# BTC_TREASURY_ADDRESS= même adresse bc1q… que ci-dessus
# BTC_NETWORK=mainnet

# Bot WhatsApp Business (optionnel — ouverture wa.me depuis l'app)
# Numéro international sans espaces ni +
VITE_WHATSAPP_BOT_NUMBER=229143267102
VITE_WHATSAPP_BOT_LABEL=+229 01 43 26 71 02

# false = paiements validés uniquement par webhook Kkiapay (PROD)
# true = settlement immédiat côté DB (sandbox local uniquement)
VITE_DEMO_PAYMENTS=false

# Obligatoire pour le webhook WhatsApp local (vite-plugin) : /solde, CREER, TONTINE
# Dashboard Supabase → Settings → API → service_role (ne jamais commiter)
SUPABASE_SERVICE_ROLE_KEY=

# Edge functions (serveur uniquement — ne pas préfixer VITE_)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# CRON_SECRET=
