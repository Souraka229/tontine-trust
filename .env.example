# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Kkiapay (sandbox)
VITE_KKIAPAY_BASE_URL=https://api.kkiapay.me
VITE_KKIAPAY_PUBLIC_KEY=
VITE_KKIAPAY_PRIVATE_KEY=
VITE_KKIAPAY_SECRET=
VITE_KKIAPAY_SANDBOX=true

# Convex (optionnel)
VITE_CONVEX_URL=

# Adresse trésor Bitcoin (vérifiable sur mempool.space)
VITE_BTC_TREASURY_ADDRESS=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh

# true = settlement immédiat côté DB ; false = attendre webhook Kkiapay (PROD)
VITE_DEMO_PAYMENTS=true

# Obligatoire pour le webhook WhatsApp local (vite-plugin) : /solde, CREER, TONTINE
# Dashboard Supabase → Settings → API → service_role (ne jamais commiter)
SUPABASE_SERVICE_ROLE_KEY=

# Edge functions (serveur uniquement — ne pas préfixer VITE_)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# CRON_SECRET=
